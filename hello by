day = input("Enter your day:")



if day == "monday":
    print("This is the weekday monday")
elif day == "tuesday":
    print("This is the weekday tuesday")
elif day == "wednesday":
    print("This is the week day wednesday") 
elif day == "thursday":
    print("This is the weekday thursday") 
elif day == "friday":
    print("This is the friday which is usually week day")  
else:
    print("This is weekend")    
